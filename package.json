{
  "name": "baseline-tsconfig",
  "version": "1.0.0",
  "description": "A library for obtaining TypeScript tsconfig.json target and lib settings compatible with Web Platform Baseline targets.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "jsdelivr": "./dist/index.js",
  "files": [
    "dist/*",
    "LICENSE.txt",
    "README.md"
  ],
  "bin": {
    "baseline-tsconfig": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c && rm -f dist/cli.d.ts",
    "update-timeline": "node scripts/create-timeline.mjs",
    "test:unit": "node --test test/*.test.mjs test/*.test.cjs",
    "test": "npm run build && npm run test:unit"
  },
  "keywords": [
    "baseline",
    "web-features",
    "typescript",
    "tsconfig",
    "ecmascript",
    "es-samples"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.0.9",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.3",
    "@types/node": "^22.19.21",
    "es-samples": "github:e18e/es-samples",
    "prettier": "^3.5.3",
    "rollup": "^4.44.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "web-features": "^3.34.2"
  }
}
